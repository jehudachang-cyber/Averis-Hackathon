[TEMPLATE]
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is gitignored (AGENTS.md §0.5).
#
# Gemini API key(s), comma-separated with no spaces, used for rotation:
#   - Each team member creates their own key at
#     https://aistudio.google.com/apikey
#   - Put every team key here to multiply the free-tier rate limit and
#     survive individual key revocations.
# Example: GEMINI_API_KEYS=AIza...aaa,AIza...bbb,AIza...ccc
GEMINI_API_KEYS=
#
# Gemini model(s), tried in rotation until one works. Default order
# (ADR-0006): gemini-3.8-flash, gemini-2.5-flash, gemini-3.5-flash-lite,
# gemini-3.1-flash-lite — if one model hits a rate limit (or is retired), the
# next is used. Leave both empty to use the default rotation, pin one model
# via GEMINI_MODEL, or override the whole list via GEMINI_MODELS
# (comma-separated).
# Example: GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash
GEMINI_MODELS=
GEMINI_MODEL=
#
# ---------------------------------------------------------------------------
# Auto-resolve mailer (issue #51). All optional: unset, the send endpoint
# answers 503 "mailer not configured" and the dashboard works fine without it.
# ---------------------------------------------------------------------------
# Gmail account that sends the correction emails (SMTP, App Password).
GMAIL_USER=
# 16-char Gmail App Password (requires 2FA on the account). NEVER commit.
GMAIL_APP_PASSWORD=
# Where sandboxed sends land (the team's own inbox). Unset + no
# ALLOW_REAL_SEND: the send endpoint answers 503 "no recipient available".
SANDBOX_RECIPIENT=
# Real-delivery kill switch. MUST stay unset/empty except on a real GCP
# deploy when the operator deliberately wants counterparty delivery.
# "1" = send to the email's from address; anything else = sandbox.
ALLOW_REAL_SEND=
